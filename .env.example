# Dispatch v2 settings. Copy to .env (git-ignored) and fill in what you need.
# Real environment variables override this file. Everything here is optional for local dev.

# Database: unset = SQLite file dispatch_dev.db
# DATABASE_URL=postgresql+psycopg://dispatch:dispatch@127.0.0.1:5432/dispatch
OSRM_URL=http://127.0.0.1:5000
# OSRM_TIME_FACTOR=1.0
# PLAN_TIME_LIMIT_S=1.0

# LLM decision provider + ops agent (Gemini, from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# LLM_PROB_METHOD=auto            # auto | logprobs | sampling

# Optional judgment model: Jev (TypeSafe, https://console.typesafe.ai/keys)
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest

# Failed-delivery prevention (spec section 10)
# RISK_CONFIRM_THRESHOLD=0.1      # ask customers to confirm above this chance of failing
# MAX_ATTEMPTS=3                  # genuine failed attempts before return to origin
# RISK_HOLDOUT=0                  # share of risky orders NOT messaged, so a trained model gets unbiased data

# Decision chains and shadow providers (spec section 7)
# DECIDERS=incident_triage=jev,llm,human
# DECIDERS_SHADOW=jev
